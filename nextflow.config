/*
 * smrna-nextflow — Nextflow DSL2 configuration.
 * All paths default to null; nothing absolute here.
 */

manifest {
    name            = 'smrna-nextflow'
    author          = 'BCI-KRP'
    homePage        = 'https://github.com/damouzo/smrna-nextflow'
    description     = 'Downstream small RNA-seq analysis on nf-core/smrnaseq 2.4.x results'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.2.0'
}

params {

    // ------------------------------------------------------------------
    // Per run (params.yaml) — inputs
    // ------------------------------------------------------------------
    nfcore_dir  = null          // nf-core/smrnaseq results/ directory
    samplesheet = null          // samplesheet.csv
    contrasts   = null          // contrasts.csv

    // ------------------------------------------------------------------
    // Per run (params.yaml) — output and optional phases
    // ------------------------------------------------------------------
    outdir      = 'results'     // deliverables/, raw/, run_info/
    batch_col   = 'batch'       // samplesheet column with the batch (e.g. Exp4); applied per group when it has >= 2 levels
    run_biotype     = false     // phase 2
    run_isomir      = false     // phase 3
    run_functional  = false     // phase 3

    // ------------------------------------------------------------------
    // Per project
    // ------------------------------------------------------------------
    species          = 'hsa'
    expected_adapter = 'AGATCGGAAGAGCACACGTCT'  // warns if the nf-core run declared another
    trim3p           = 0        // nt trimmed from 3' in the biotype module (raise if nf-core was not relaunched)

    genome_fasta    = null      // biotype: Ensembl primary assembly FASTA
    bowtie_index    = null      // biotype: built from genome_fasta if null
    gtf             = null      // biotype: Ensembl GTF
    ncrna_bed       = null      // biotype: RNAcentral genome-coordinate BED
    mirtarbase_file = null      // functional enrichment

    // Read probes: count reads derived from given probe sequences (shRNA constructs, etc.)
    // in the mirtrace collapsed FASTA. Generic: no knockdown-specific logic.
    probe_file          = null  // probes.tsv with columns probe_id, sequence
    probe_mismatches    = 0     // 0 or 1; a read counts if it matches a substring of a probe
    probe_min_len       = 18    // minimum match length, same as the mirTrace minimum
    probe_top_unknown_n = 0     // write the top N 'unknown' sequences per sample (0 disables)
    probe_top_hits_n    = 20    // top N read sequences per sample and probe in probe_hits.tsv

    container       = null      // overrides the default image

    // ------------------------------------------------------------------
    // Analysis defaults — change only as an analysis decision
    // ------------------------------------------------------------------
    count_source            = 'mirtop'   // mirtop | mature
    isomir_exclude_variants = 'iso_snv_seed,iso_snv_central,iso_snv_central_offset,iso_snv_central_supp'

    isomir_max_shift_5p = 2
    isomir_max_shift_3p = 5
    isomir_min_len      = 18

    qc_min_mirna_frac   = 0.10
    qc_max_trna_frac    = 0.30
    qc_max_rrna_frac    = 0.20
    qc_min_mirna_reads  = 1000000

    sensitivity_exclude_flags = 'LOW_MIRNA_FRAC,LOW_DEPTH'

    min_cpm         = 1
    min_total_count = 10        // min_samples = smallest level size of the group

    alpha     = 0.05
    lfc_flag  = 1

    shrink_type = 'ashr'
    n_top_var   = 500

    bowtie_mismatches = 1
    bowtie_max_hits   = 50
    min_overlap_frac  = 0.8

    biotype_priority = 'miRNA,tRNA,rRNA,snoRNA,snRNA,scaRNA,Y_RNA,vault_RNA,lncRNA,protein_coding,unannotated'
    de_classes       = 'snoRNA,snRNA,tRNA,rRNA'

    isomir_min_reads = 500
    min_sig_mirnas   = 5

    seed = 42

    // ------------------------------------------------------------------
    // Resource ceilings (used by the slurm profile)
    // ------------------------------------------------------------------
    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '72.h'
    queue_size = 50
}

// Default image for every process; params.container substitutes it.
process {
    container = params.container ?: 'ghcr.io/damouzo/smrna-nextflow:latest'
    shell     = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_single {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = '32.GB'
        time   = '12.h'
    }
    withLabel: process_high {
        cpus   = 32
        memory = '128.GB'
        time   = '72.h'
    }
}

profiles {

    // ---- Singularity / Apptainer (HPC) ----
    // autoMounts kept: the bin/ scripts are staged inputs, but other projectDir
    // references (if any) still need the project tree mounted.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // ---- Docker (local workstation) ----
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    // ---- Slurm (HPC executor) ----
    slurm {
        executor {
            name      = 'slurm'
            queue     = 'compute'
            queueSize = params.queue_size
        }
        process {
            resourceLimits = [
                cpus  : params.max_cpus,
                memory: params.max_memory,
                time  : params.max_time
            ]
        }
    }
}

// Run traceability under run_info/pipeline_info.
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/run_info/pipeline_info/execution_trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/run_info/pipeline_info/execution_report.html"
}
